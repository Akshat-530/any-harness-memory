# Memory — environment template. Copy to .env and edit. NEVER commit .env.

# --- Postgres (canonical durable ledger) ---
MEMORY_PG_USER=memory
MEMORY_PG_PASSWORD=change-me-postgres
MEMORY_PG_DB=memory

# --- Redis (short-term KV, cache, graph edges) ---
MEMORY_REDIS_PASSWORD=change-me-redis

# --- Host port for the memory-mcp endpoint (bound to 127.0.0.1 only) ---
MEMORY_HTTP_PORT_HOST=4000

# --- Authentication ---
# Single-user / local: anonymous traffic is confined to an isolated namespace.
# For multi-user: set MEMORY_ALLOW_ANONYMOUS=0, mount an auth_tokens file at
# /run/auth_tokens and point MEMORY_AUTH_TOKENS at it (see auth_tokens.example).
MEMORY_PRINCIPAL=global
MEMORY_ALLOW_ANONYMOUS=1
MEMORY_ANON_IDENTITY=local
# MEMORY_AUTH_TOKENS=/run/auth_tokens

# --- Optional LLM judge (plausibility + conflict resolution). Off by default. ---
# Point at any OpenAI-compatible /v1 endpoint. Leave blank to disable.
MEMORY_CONFLICT_LLM=0
MEMORY_JUDGE_ENDPOINT=
MEMORY_JUDGE_MODEL=
MEMORY_JUDGE_API_KEY=

# --- Performance ---
MEMORY_EAGER_PREWARM=1
MEMORY_TORCH_THREADS=3

# Store waits up to N seconds for the derived Qdrant index so store->recall is immediate.
MEMORY_OUTBOX_SYNC_GRACE_SECONDS=5

# --- Optional (all default to portable in-container /data paths) ---
# MEMORY_BACKUP_DIR=/data/backup/memory_nightly
# MEMORY_EVAL_SET=/app/eval/golden_eval_set.json
# MEMORY_AGENTS_MD_PATH=/app/AGENTS.md
# MEMORY_STDIO_IDENTITY=user:me

# --- Injection & surface (defaults shown; set in .env to override) ---
# VIRTUAL_CONTEXT_ENABLED=1
# MEMORY_TOOL_PROFILE=agent      # agent (curated ~39) | full (72)
# MEMORY_MAINTENANCE=1           # nightly consolidate/dream/decay/promote/backup

# --- RAG / knowledge base ---
# MEMORY_KB_COLLECTION=kb_chunks
# MEMORY_KB_CHUNK_SIZE=900
# MEMORY_KB_CHUNK_OVERLAP=150

# --- RAG reconciliation (memory -> knowledge base) ---
# MEMORY_KB_AUTOSYNC=1
# MEMORY_KB_RECONCILE_THRESHOLD=0.80
# MEMORY_KB_SYNC_MIN_IMPORTANCE=7

# --- RAG <-> memory interconnection ---
# MEMORY_RECALL_INCLUDE_KB=1
# MEMORY_DOC_ROUTE_CHARS=2000
